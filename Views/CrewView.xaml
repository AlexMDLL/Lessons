<UserControl x:Class="WpfApp26.Views.CrewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.RenderTransform>
        <TranslateTransform />
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <!-- Плавное появление страницы при переключении раздела -->
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="16" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <!-- Строка таблицы экипажа: колонки совпадают с шапкой -->
        <DataTemplate x:Key="CrewRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="155" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Id}" Style="{StaticResource Mono}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentSoft}"
                            BorderBrush="{StaticResource AccentEdge}" BorderThickness="1">
                        <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource TextFaint}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource Bar}"
                                 Width="98" Maximum="100" Value="{Binding Health}"
                                 Foreground="{Binding Health, Converter={StaticResource HealthBrush}}" />
                    <TextBlock Text="{Binding HealthText}" Style="{StaticResource Mono}" Margin="10,0,0,0"
                               Foreground="{Binding Health, Converter={StaticResource HealthBrush}}" />
                </StackPanel>

                <Border Grid.Column="3" Style="{StaticResource Pill}" HorizontalAlignment="Left"
                        Background="#14FFFFFF"
                        BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}">
                    <TextBlock Text="{Binding Status}" FontSize="11"
                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Экипаж станции" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Состав экспедиции, состояние здоровья и текущий статус каждого члена экипажа" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource Accent}">
                        <Run Text="На борту:" />
                        <Run Text="{Binding CrewOnBoard, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="чел." />
                    </TextBlock>
                </Border>
                <Button Style="{StaticResource GhostButton}" Content="Обновить список"
                        Command="{Binding RefreshCrewCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Поиск -->
                    <Grid Grid.Row="0">
                        <Path Data="M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 1 0 10.5,3 Z M16,16 L21,21"
                              Stroke="{StaticResource TextFaint}" StrokeThickness="1.5" Width="16" Height="16"
                              Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="14,0,0,0" IsHitTestVisible="False" />
                        <TextBox x:Name="CrewSearchBox" Style="{StaticResource Input}" Padding="36,9,12,9"
                                 Text="{Binding CrewSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Поиск по имени, роли или статусу..."
                                   Foreground="{StaticResource TextFaint}" FontSize="13"
                                   Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=CrewSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Шапка таблицы -->
                    <Grid Grid.Row="1" Margin="6,16,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="165" />
                            <ColumnDefinition Width="155" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ID" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="1" Text="ЧЛЕН ЭКИПАЖА" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="ЗДОРОВЬЕ" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="3" Text="СТАТУС" Style="{StaticResource Caption}" />
                    </Grid>

                    <!-- Список -->
                    <ListBox Grid.Row="2" Style="{StaticResource RowsListBox}"
                             ItemTemplate="{StaticResource CrewRowTemplate}"
                             ItemsSource="{Binding Crew}"
                             SelectedItem="{Binding SelectedCrewMember, Mode=TwoWay}" />

                    <!-- Ничего не найдено -->
                    <TextBlock Grid.Row="2" Text="По запросу никого не найдено"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Crew.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Панель операций -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="ОПЕРАЦИИ С ЭКИПАЖЕМ" Style="{StaticResource Caption}" />

                        <!-- Выбранный член экипажа -->
                        <Border Style="{StaticResource CardFlat}" Margin="0,10,0,0"
                                Visibility="{Binding HasSelectedCrewMember, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource AccentSoft}"
                                            BorderBrush="{StaticResource AccentEdge}" BorderThickness="1">
                                        <TextBlock Text="{Binding SelectedCrewMember.Initials}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedCrewMember.Name}" FontSize="13.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                        <TextBlock Text="{Binding SelectedCrewMember.Role}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </StackPanel>

                                <ProgressBar Style="{StaticResource Bar}" Margin="0,12,0,0" Height="10"
                                             Maximum="100" Value="{Binding SelectedCrewMember.Health}"
                                             Foreground="{Binding SelectedCrewMember.Health, Converter={StaticResource HealthBrush}}" />
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SelectedCrewMember.HealthText}" Style="{StaticResource Mono}"
                                               Foreground="{Binding SelectedCrewMember.Health, Converter={StaticResource HealthBrush}}" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Mono}"
                                               Text="{Binding SelectedCrewMember.Status}"
                                               Foreground="{Binding SelectedCrewMember.Status, Converter={StaticResource StatusBrush}}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                                   Text="Выберите строку в таблице, чтобы применить операцию."
                                   Visibility="{Binding HasSelectedCrewMember, Converter={StaticResource InverseBoolToVis}}" />

                        <Border Style="{StaticResource Divider}" />

                        <!-- Урон -->
                        <TextBlock Text="Нанести урон (1–100)" Style="{StaticResource Label}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Input}" Text="{Binding DamageText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Нанести"
                                    Margin="8,0,0,0" Command="{Binding DamageCommand}" />
                        </Grid>

                        <!-- Восстановление -->
                        <TextBlock Text="Восстановить здоровье" Style="{StaticResource Label}" Margin="0,14,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Input}" Text="{Binding HealText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource SuccessButton}" Content="Лечить"
                                    Margin="8,0,0,0" Command="{Binding HealCommand}" />
                        </Grid>

                        <!-- Статус -->
                        <TextBlock Text="Изменить статус" Style="{StaticResource Label}" Margin="0,14,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Input}" Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Применить"
                                    Margin="8,0,0,0" Command="{Binding SetStatusCommand}" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="ЖУРНАЛ ОПЕРАЦИЙ" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding CrewLog}" Style="{StaticResource Mono}" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
