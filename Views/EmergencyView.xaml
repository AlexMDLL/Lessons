<UserControl x:Class="WpfApp26.Views.EmergencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.RenderTransform>
        <TranslateTransform />
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <!-- Плавное появление страницы при переключении раздела -->
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="16" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <DataTemplate x:Key="EmergencyRowTemplate">
            <Border Style="{StaticResource CardFlat}" Margin="0,0,0,6" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Style="{StaticResource Pill}" Background="#14FFFFFF"
                            BorderBrush="{Binding Status, Converter={StaticResource StatusBrush}}">
                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="14" Padding="18"
                BorderBrush="#66FF5C7A" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#33FF5C7A" Offset="0" />
                    <GradientStop Color="#12191527" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Data="M12,3.4 L21.7,20 H2.3 Z M12,9 V14.2 M12,16.6 V17.5"
                      Stroke="{StaticResource Danger}" StrokeThickness="1.6" Width="46" Height="46"
                      Stretch="Uniform" StrokeLineJoin="Round" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="ВНИМАНИЕ!" FontSize="21" FontWeight="Bold" Foreground="#FFFF95AA" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Text="Аварийный режим: проверяются экипаж, двигатели и связь." />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerButton}" Content="ЗАПУСТИТЬ ПРОВЕРКУ"
                            Command="{Binding EmergencyCommand}" IsEnabled="{Binding IsNotDiagnosticsRunning}"
                            MinWidth="200" />
                    <Button Style="{StaticResource GhostButton}" Content="СНЯТЬ ТРЕВОГУ" Margin="10,0,0,0"
                            Command="{Binding ResetEmergencyCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="АВАРИЙНАЯ ДИАГНОСТИКА" Style="{StaticResource Caption}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Экипаж" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Height="10" Maximum="100"
                                     Value="{Binding CrewProgress}" VerticalAlignment="Center"
                                     Foreground="{StaticResource Danger}" />
                        <TextBlock Grid.Column="2" Text="{Binding CrewProgress, StringFormat={}{0}%}"
                                   Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Двигатели" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Height="10" Maximum="100"
                                     Value="{Binding SystemsProgress}" VerticalAlignment="Center"
                                     Foreground="{StaticResource Danger}" />
                        <TextBlock Grid.Column="2" Text="{Binding SystemsProgress, StringFormat={}{0}%}"
                                   Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Связь" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Style="{StaticResource Bar}" Height="10" Maximum="100"
                                     Value="{Binding CommunicationProgress}" VerticalAlignment="Center"
                                     Foreground="{StaticResource Danger}" />
                        <TextBlock Grid.Column="2" Text="{Binding CommunicationProgress, StringFormat={}{0}%}"
                                   Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <TextBlock Text="ПРОВЕРОК ВЫПОЛНЕНО" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DiagnosticResults.Count, StringFormat={}{0}}"
                               FontSize="34" FontWeight="Bold" Foreground="{StaticResource Danger}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="РЕЗУЛЬТАТ ДИАГНОСТИКИ" Style="{StaticResource Caption}" />

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Verdict}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{Binding Verdict, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding DiagnosticResults}"
                                      ItemTemplate="{StaticResource EmergencyRowTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
