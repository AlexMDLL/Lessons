<Window x:Class="WpfApp26.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WpfApp26.Views"
        mc:Ignorable="d"
        Title="Центр управления космической станцией"
        Height="860" Width="1400" MinHeight="660" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Шаблон пункта меню: номер пункта + название раздела -->
        <DataTemplate x:Key="NavItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="7"
                        Background="{StaticResource AccentSoft}"
                        BorderBrush="{StaticResource AccentEdge}" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Number}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Text}" />
                    <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{StaticResource TextFaint}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Страницы. DataTemplate выбирается по текущему разделу -->
        <DataTemplate x:Key="CrewTemplate">
            <views:CrewView />
        </DataTemplate>
        <DataTemplate x:Key="SystemsTemplate">
            <views:SystemsView />
        </DataTemplate>
        <DataTemplate x:Key="CommunicationTemplate">
            <views:CommunicationView />
        </DataTemplate>
        <DataTemplate x:Key="MessagesTemplate">
            <views:MessagesView />
        </DataTemplate>
        <DataTemplate x:Key="DiagnosticsTemplate">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate x:Key="EmergencyTemplate">
            <views:EmergencyView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Stroke}" BorderThickness="1" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#FF0E0B16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="{StaticResource Accent}" Opacity="0.25" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" />
                    </Grid>
                    <TextBlock Text="SPACE STATION CONTROL" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Width="1" Height="16" Background="{StaticResource Stroke}" Margin="12,0" />
                    <TextBlock Text="ЦУП · орбитальная станция «ЗАРЯ-7»" FontSize="12"
                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Border Style="{StaticResource Pill}" Margin="0,0,10,0"
                            Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Danger}" VerticalAlignment="Center" />
                            <TextBlock Text="АВАРИЙНЫЙ РЕЖИМ" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="#FFFF95AA" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_Click" ToolTip="Свернуть" />
                    <Button Style="{StaticResource ChromeButton}" Content="□" Click="Maximize_Click" ToolTip="Развернуть" />
                    <Button Style="{StaticResource CloseButton}" Content="✕" Click="Close_Click" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource DangerGradient}" Padding="16,8"
                    Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}">
                <Border.Triggers>
                    <!-- полоса тревоги слегка пульсирует -->
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.7" To="1"
                                                 Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12,3.4 L21.7,20 H2.3 Z M12,9 V14.2 M12,16.6 V17.5"
                          Stroke="#FF2A0510" StrokeThickness="1.6" Width="20" Height="20" Stretch="Uniform"
                          StrokeLineJoin="Round" VerticalAlignment="Center" />
                    <TextBlock Text="ВНИМАНИЕ! СТАНЦИЯ В АВАРИЙНОМ РЕЖИМЕ — ОПЕРАТОРУ ПРОВЕРИТЬ ВСЕ СИСТЕМЫ"
                               FontSize="12" FontWeight="Bold" Foreground="#FF2A0510" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FF0E0B17" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Карточка станции -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,14,12,8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ОБЪЕКТ" Style="{StaticResource Caption}" />
                                <TextBlock Text="ОРБИТАЛЬНАЯ СТАНЦИЯ" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}" Margin="0,3,0,0" />
                                <TextBlock Text="«ЗАРЯ-7» · LEO 408 км" Style="{StaticResource Muted}" Margin="0,2,0,0" />

                                <Border Style="{StaticResource Divider}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Экипаж на борту" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding CrewOnBoard}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Режим" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding StationModeText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding StationModeText, Converter={StaticResource StatusBrush}}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Полетное время" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding MissionTime}" Style="{StaticResource Mono}"
                                               Foreground="{StaticResource Text}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="ПУЛЬТ УПРАВЛЕНИЯ" Style="{StaticResource Caption}" Margin="22,10,0,6" />

                        <!-- Меню разделов -->
                        <ListBox Grid.Row="2"
                                 Style="{StaticResource NavListBox}"
                                 ItemTemplate="{StaticResource NavItemTemplate}"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}" />

                        <StackPanel Grid.Row="3" Margin="12,10,12,14">
                            <Button Style="{StaticResource DangerButton}" Content="АВАРИЙНЫЙ РЕЖИМ"
                                    Command="{Binding EmergencyCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="СНЯТЬ ТРЕВОГУ" Margin="0,8,0,0"
                                    Command="{Binding ResetEmergencyCommand}"
                                    Visibility="{Binding IsEmergency, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Текущая страница -->
                <ContentControl Grid.Column="1" Content="{Binding}" ClipToBounds="True">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource CrewTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Systems">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SystemsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Communication">
                                    <Setter Property="ContentTemplate" Value="{StaticResource CommunicationTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Messages">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessagesTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Diagnostics">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DiagnosticsTemplate}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentSection}" Value="Emergency">
                                    <Setter Property="ContentTemplate" Value="{StaticResource EmergencyTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>

            <Border Grid.Row="3" Background="#FF0A0811" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDbAvailable}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionInfo}" Style="{StaticResource Mono}" Margin="8,0,0,0" />
                        <Border Style="{StaticResource Pill}" Background="#1AFFC24B" BorderBrush="#55FFC24B"
                                Margin="10,0,0,0" Padding="8,2"
                                Visibility="{Binding IsDbAvailable, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="ДЕМО-РЕЖИМ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Warning}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding OperationStatus}" Style="{StaticResource Mono}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MissionTime}" Style="{StaticResource Mono}" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="   ·   WpfApp26   ·   урок 8" Style="{StaticResource Mono}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
